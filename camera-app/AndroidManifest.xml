<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.sunkencity.l16studio"
    android:versionCode="3"
    android:versionName="0.2.1">

    <!-- Target 22 so storage access is granted at install time: this app is
         only meant for the Light L16 (Android 6.0.1), and it must work the
         moment it is installed over adb. -->
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="22" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:largeHeap="true"
        android:allowBackup="false">

        <activity
            android:name=".GalleryActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ViewerActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/AppTheme.Fullscreen"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".EditActivity"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/AppTheme.Fullscreen"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- "Screen off": a second entry in the app list that puts the
             camera to sleep, for units whose power button doesn't work. -->
        <activity
            android:name=".SleepActivity"
            android:label="Screen off"
            android:icon="@drawable/ic_sleep"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:taskAffinity="dev.sunkencity.l16studio.sleep">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".NapActivity"
            android:theme="@style/AppTheme.Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="dev.sunkencity.l16studio.sleep"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <receiver
            android:name=".AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Lift to wake: the counterpart of Screen off. -->
        <service android:name=".WakeService" android:exported="false" />
        <receiver android:name=".WakeService$BootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service android:name=".TransferService" android:exported="false" />
    </application>
</manifest>
